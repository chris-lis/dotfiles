{{- $env_choices := list "personal" "work" -}}
{{- $env := promptChoiceOnce . "env" "Pick environmnet to set up" $env_choices -}}

{{- $default_git_email := "" -}}
{{- if eq $env "personal" -}}
{{-   $default_git_email = "32350102+chris-lis@users.noreply.github.com" -}}
{{- end -}}

{{- $git_email := promptStringOnce . "git.email" "Enter git email" $default_git_email -}}

{{- /* Machine-specific opt-in, see the herdr-link-* scripts in dot_local/bin. */ -}}
{{- $herdr_link := promptBoolOnce . "herdrLinkEnabled" "Enable herdr link on this machine" false -}}

[data]
    env = {{ $env | quote }}
    herdrLinkEnabled = {{ $herdr_link }}

[data.git]
    email = {{ $git_email | quote }}

# Three-way merge in nvim rather than the default bare `vimdiff`, which is
# /usr/bin/vim and picks up none of the nvim config. Because args contains no
# template variables, chezmoi appends .Destination, .Source and .Target itself.
# Pane order is therefore: destination (live file), source (THIS repo — the
# pane to edit), target (a temp file; edits there are discarded).
[merge]
    command = "nvim"
    args = ["-d"]
