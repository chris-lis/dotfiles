# MacOS directory metadata
# A bare `.DS_Store` would only match at the root: chezmoi matches full target
# paths, not base names. (A leading slash before `**` is rejected outright.)
**/.DS_Store

# Ignore when not on MacOS
{{ if ne .chezmoi.os "darwin" }}

.chezmoiscripts/*.darwin.sh
.config/linearmouse
Library

{{ end }}

.config/nvim/lazy-lock.json

# herdr link: machine-specific, so only where `chezmoi init` was answered yes
# (data.herdrLinkEnabled).
{{ if not (get . "herdrLinkEnabled") }}
.local/bin/herdr-link-ssh-guard
Library/LaunchAgents/dev.herdr-link.session.plist
{{ end }}

# Claude Code configuration
# Guard against `chezmoi add -r ~/.claude` pulling in history.jsonl, sessions/
# or projects/. Single-star is required: `.claude/**` silently defeats the
# negations below. Note chezmoi already ignores the repo's own .claude/ dir,
# since source entries beginning with "." are skipped automatically.
.claude/*
!.claude/settings.json
!.claude/statusline-command.sh
!.claude/subagent-statusline.sh
!.claude/keybindings.json
.config/nvim/.claude
