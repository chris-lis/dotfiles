#!/bin/bash
# Forced command for the herdr_link key in ~/.ssh/authorized_keys. Lets the
# other user account's herdr reach this account's running herdr server, and
# nothing else.
set -u
deny() { echo "herdr-link-ssh-guard: $*" >&2; exit 1; }

# Only while this account has a desktop session: that is when its Keychain,
# and with it Claude Code's login, is usable.
launchctl print "gui/$(id -u)" >/dev/null 2>&1 ||
  deny "$(id -un) is not logged in on the desktop"

# Only with a herdr server already running, so a connection can never start
# one: a server started over SSH cannot use the Keychain.
/opt/homebrew/bin/herdr status server 2>/dev/null | grep -q '^ *status: running' ||
  deny "no herdr server is running for $(id -un); it starts at desktop login"

[ -n "${SSH_ORIGINAL_COMMAND:-}" ] || deny "this key does not allow interactive logins"

exec "${SHELL:-/bin/zsh}" -c "$SSH_ORIGINAL_COMMAND"
